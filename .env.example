# Server Configuration
NODE_ENV=development
PORT=3000

# Database - Local MongoDB
# MONGODB_URL=mongodb://localhost:27017/taskpro

# Database - MongoDB Atlas (Production)
MONGODB_USER=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_DB=taskpro
MONGODB_URL=mongodb+srv://${MONGODB_USER}:${MONGODB_PASSWORD}@cluster.mongodb.net/${MONGODB_DB}?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=30d

# Application Domain
APP_DOMAIN=http://localhost:5173

# Cloudinary Configuration (for image uploads - avatars, backgrounds)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
ENABLE_CLOUDINARY=true

# Email Configuration (Brevo/Sendinblue SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email@gmail.com
SMTP_PASSWORD=your_brevo_smtp_api_key
SMTP_FROM=taskpro.project@gmail.com
SMTP_TO=taskpro.project@gmail.com

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Production Notes:
# 1. Change JWT_SECRET to a strong random string (minimum 32 characters)
# 2. Update MONGODB_URL with your production database credentials
# 3. Set NODE_ENV=production
# 4. Update APP_DOMAIN and CORS_ORIGIN to your production domain
# 5. Configure Cloudinary account at https://cloudinary.com
# 6. Get Brevo SMTP credentials at https://www.brevo.com


